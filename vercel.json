{
  "services": {
    "frontend": {
      "root": "Frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "Backend/",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "Backend" } },
    { "source": "/(.*)", "destination": { "service": "Frontend" } }
  ]
}